# ============================================================================
# BAZspark Environment Configuration Template (DEVELOPMENT / QUICK START)
# ============================================================================
#
# See the FULL canonical production template at .env.production.example
# for the complete variable list, security policy, and per-service docs.
#
# SECURITY POLICY:
#   - NEVER commit real keys to this repository. Placeholders only.
#   - In production, inject real values via:
#       * HuggingFace Space Secrets: https://huggingface.co/spaces/ahmdelbaz28/BAZSPARK/settings
#       * Vercel Environment Variables: https://vercel.com/ahmdelbaz28-uxs-projects
#       * GitHub Actions Secrets: pushed via scripts/set_github_secrets.py
#   - The backend startup validator (backend/env_validator.py) hard-fails
#     if any REQUIRED variable is missing or still a placeholder in production.
# ============================================================================

# ── Runtime ──
FIREAI_ENV=development
FIREAI_API_KEY=dev-fireai-key-local
# Min 43 chars (256 bits). Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
FIREAI_SESSION_SECRET=dev-session-secret-please-replace-with-64-chars-minimum-xxxxxxxxx

# ── Database (Supabase primary, Neon fallback) ──
DATABASE_URL=sqlite:///./fireai.db
# DATABASE_URL=postgresql://postgres.<REF>:<PW>@aws-0<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
# NEON_DATABASE_URL=postgresql://<U>:<P>@ep-<EP>.<REGION>.aws.neon.tech/<DB>?sslmode=require
DIGITAL_TWIN_DB_PATH=./db/digital_twin.db
UDM_DB_PATH=./db/udm_elements.db

# ── Supabase Auth + REST ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── LLM & AI Subsystems (F6 — full documentation) ──────────────────────────
# The platform has FOUR LLM/AI layers. All of them are ADVISORY ONLY and
# never override the deterministic NFPA 72 / NEC engine.
#
# 1) PRIMARY CHAT LLM (Zenmux / any OpenAI-compatible API) — powers
#    /api/v1/llm/chat + /chat/stream. Without ZENMUX_API_KEY the endpoints
#    return 503 LLM_SERVICE_UNAVAILABLE (the rest of the platform works).
ZENMUX_API_KEY=zm_...
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_MODEL=z-ai/glm-4.7-flash-free
ZENMUX_REQUEST_TIMEOUT=60
ZENMUX_MAX_TOKENS=2000
# Optional OpenAI-compatible FALLBACK provider (Alibaba Cloud MaaS etc.)
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_MODEL=qwen-plus
#
# 2) MEMORY LAYER (Mem0 + local Qdrant) — /api/memory/* and the workflow
#    memory_enrich node. Uses an OpenAI-compatible key for embeddings;
#    falls back to Gemini embeddings when OPENAI_API_KEY is unset.
#    mem0_setup.py also accepts NVIDIA build.nvidia.com credentials for
#    LLM-based fact extraction.
OPENAI_API_KEY=sk-...            # embeddings for Mem0 (preferred)
# FIREAI_OPENAI_API_KEY=sk-...   # alternate name, same purpose
GEMINI_API_KEY=AIza...           # fallback embeddings if OpenAI key missing
NVIDIA_API_KEY=napi_...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
#
# 3) TIER-2 SELF-HEALING (local Ollama llama3) — QOMN kernel LLM recovery.
#    DISABLED BY DEFAULT (safety gate). When disabled, Tier 2 re-raises the
#    original error and every gate block is recorded in the healing audit
#    ledger. Enable ONLY on controlled deployments.
QOMN_ENABLE_LLM_HEALING=false
# OLLAMA_HOST=http://localhost:11434   # (currently hardcoded; reserved)
QOMN_AUDIT_SECRET_KEY=change-me-please
QOMN_AUDIT_LOG_PATH=./qomn_fire_healing_audit.jsonl
#
# 4) OBSERVABILITY (Langfuse) — optional LLM tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# ── Resend Email ──
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=BAZspark <onboarding@resend.dev>

# ── Box ──
BOX_CLIENT_ID=YOUR_BOX_CLIENT_ID
BOX_CLIENT_SECRET=YOUR_BOX_CLIENT_SECRET
BOX_DEVELOPER_TOKEN=YOUR_BOX_DEVELOPER_TOKEN
CLIENT_NAME=bazspark

# ── Autodesk APS (AutoCAD / Revit Cloud Bridge) ──
APS_CLIENT_ID=APS_CLIENT_ID
APS_CLIENT_SECRET=APS_CLIENT_SECRET
APS_CLIENT_NAME=bazspark
APS_WEBHOOK_URL=http://localhost:8000/api/v2/aps/webhook

# ── Vercel ──
VERCEL_DEPLOY_TOKEN=vcp_...
VERCEL_PROJECT_ID=prj_...
VERCEL_TEAM_ID=team_...

# ── Hugging Face Spaces ──
HF_TOKEN=hf_...

# ── GitHub ──
GH_PAT=github_pat_...
GH_REPO=ahmdelbaz28-ux/BAZspark
GH_DEFAULT_BRANCH=main

# ── SonarCloud ──
SONAR_TOKEN=YOUR_SONAR_TOKEN
SONAR_ORGANIZATION=ahmdelbaz28-ux
SONAR_PROJECT_KEY=ahmdelbaz28-ux_revit
SONAR_HOST_URL=https://sonarcloud.io

# ── Cloudflare (DNS / WAF / Edge) ──
CLOUDFLARE_API_TOKEN=cfut_...
CLOUDFLARE_USER_TOKEN_1=cfut_...
CLOUDFLARE_USER_TOKEN_2=cfut_...
CLOUDFLARE_USER_TOKEN_3=cfut_...

# ── Daytona / CodeSandbox VPS ──
DAYTONA_API_TOKEN=dtn_...
CODESANDBOX_TOKEN=csb_v1_...

# ── CORS ── (comma-separated explicit origins; wildcards FORBIDDEN in prod)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ── Self-Healing Audit ──
QOMN_AUDIT_SECRET_KEY=
QOMN_AUDIT_LOG_PATH=./qomn_fire_healing_audit.jsonl

# ── Optional on HF Space: serve the pre-built frontend ──
# BAZSPARK_FRONTEND_DIST=/app/frontend_dist

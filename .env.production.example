# ============================================================================
# BAZspark Unified Production Environment Template
# ============================================================================
#
# SECURITY POLICY (MANDATORY):
#   - This file is a TEMPLATE. NEVER commit real secrets to the repository.
#   - Every value below MUST be a placeholder (e.g. <PLACEHOLDER>) or be
#     injected at runtime via:
#       * HuggingFace Space Secrets  → https://huggingface.co/spaces/ahmdelbaz28/BAZSPARK/settings
#       * Vercel Environment Variables → https://vercel.com/bazspark/ba-zspark/settings
#       * GitHub Actions Secrets      → pushed via scripts/set_github_secrets.py
#   - The fast .gitignore rule (`.env*` with `!.env.example` / `!.env.example.txt`
#     / `!.env.production.example`) keeps real `.env.production` OUT of git.
#   - The backend startup validator (backend/env_validator.py) ENFORCES the
#     presence of all REQUIRED variables below and hard-fails if any are
#     missing or still set to a placeholder.
#
# Naming convention:
#   - UPPERCASE_SNAKE_CASE for all keys (POSIX env var standard).
#   - One canonical key per service (no aliases) unless a legacy alias is
#     required for backward compatibility (explicitly marked).
#
# Rejected env files:
#   - env.example.txt is the legacy template (superseded by this file). The
#     backend/e2e validator load the canonical .env.production first then fall
#     back to .env. The legacy env.example.txt is kept only for historical
#     reference and MUST NOT be used in production.
# ============================================================================


# ─── 0. Runtime / Application ───────────────────────────────────────────────
FIREAI_ENV=production
# API key required from every client via the X-API-Key header.
FIREAI_API_KEY=<FIREAI_API_KEY>
# Session secret signing the HttpOnly auth cookie. MIN 43 chars (256 bits).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
FIREAI_SESSION_SECRET=<FIREAI_SESSION_SECRET_MIN_43_CHARS>
# Startup env gate: "strict" (default) = app refuses to boot if HARD vars are
# missing; "warn" = degraded mode (missing HARD vars become loud warnings only).
# Use "warn" ONLY while rotating secrets on a live deployment.
FIREAI_ENV_VALIDATION=strict

# ─── 1. Database (Supabase Postgres, primary) ──────────────────────────────
# Primary: Supabase connection pooler (IPv4-friendly Transaction mode).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
# Fallback (if Supabase IPv6 endpoint unreachable from HF Space free tier).
NEON_DATABASE_URL=postgresql://<NEON_USER>:<NEON_PASSWORD>@ep-<EP>.<REGION>.aws.neon.tech/<DB>?sslmode=require
# UDM (Universal Data Model) — separate SQLite store, avoids schema collision.
DIGITAL_TWIN_DB_PATH=/app/data/digital_twin.db
UDM_DB_PATH=/app/data/udm_elements.db

# ─── 2. Supabase Auth + REST ─────────────────────────────────────────────────
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_ANON_JWT>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_JWT>
# REST base (derived from SUPABASE_URL but explicit for clarity).
SUPABASE_REST_URL=https://<PROJECT_REF>.supabase.co/rest/v1/

# ─── 3. Langfuse LLM Observability ──────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=<pk-lf-...>
LANGFUSE_SECRET_KEY=<sk-lf-...>
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # legacy alias kept for older SDKs
LANGFUSE_ENABLED=true

# ─── 4. NVIDIA build.nvidia.com LLM Provider ────────────────────────────────
NVIDIA_API_KEY=<napi_...>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2

# ─── 4b. Zenmux Primary LLM Provider ──────────────────────────────────────
# audit P1-7 follow-up: was missing from production template despite being
# the primary LLM provider (backend/services/llm_service.py).
ZENMUX_API_KEY=<ZENMUX_API_KEY>
ZENMUX_BASE_URL=<ZENMUX_BASE_URL>
ZENMUX_MODEL=<ZENMUX_MODEL>

# ─── 4c. OpenAI / Gemini Embedding Providers ──────────────────────────────
# audit P1-7 follow-up: used for Mem0 embeddings and fallback.
OPENAI_API_KEY=<OPENAI_API_KEY>
GEMINI_API_KEY=<GEMINI_API_KEY>

# ─── 5. Resend Email Service ─────────────────────────────────────────────────
RESEND_API_KEY=<re_...>
RESEND_FROM_EMAIL=BAZspark <onboarding@resend.dev>
RESEND_REPLY_TO=support@bazspark.example

# ─── 6. Box Integration ─────────────────────────────────────────────────────
# PLANNED: Box SDK integration is not yet implemented in the backend runtime.
# The BOX_* variables below are placeholders for future implementation.
# Once implemented, add BOX_* entries to backend/env_validator.py as SOFT.
# See: https://github.com/ahmdelbaz28-ux/BAZspark/issues/XXX
BOX_CLIENT_ID=<BOX_CLIENT_ID>
BOX_CLIENT_SECRET=<BOX_CLIENT_SECRET>
BOX_DEVELOPER_TOKEN=<BOX_DEVELOPER_TOKEN>
CLIENT_NAME=bazspark

# ─── 7. Autodesk APS (AutoCAD / Revit Cloud Bridge) ─────────────────────────
APS_CLIENT_ID=<APS_CLIENT_ID>
APS_CLIENT_SECRET=<APS_CLIENT_SECRET>
APS_CLIENT_NAME=bazspark
# Webhook callback base. APS posts Derivative/Model-Derivative + Revit/AutoCAD
# job events back to this public HTTPS endpoint.
APS_WEBHOOK_URL=https://api.bazspark.example/api/v2/aps/webhook
APS_CALLBACK_URL=https://api.bazspark.example/api/v2/aps/callback

# ─── 8. Vercel Deployment ───────────────────────────────────────────────────
VERCEL_DEPLOY_TOKEN=<vcp_...>
VERCEL_PROJECT_ID=<prj_...>
VERCEL_TEAM_ID=<team_...>
# Auto-deploy hook URL (Vercel Git integration OR a Deploy Hook for push-driven builds).
VERCEL_DEPLOY_HOOK_URL=<https://api.vercel.co/v1/...>

# ─── 9. Hugging Face Spaces ─────────────────────────────────────────────────
HF_TOKEN=<hf_...>
HF_USERNAME=ahmdelbaz28
HF_SPACE_NAME=BAZSPARK
HF_SPACE_REPO=https://huggingface.co/spaces/ahmdelbaz28/BAZSPARK

# ─── 10. GitHub Source Repository ────────────────────────────────────────────
GH_PAT=<github_pat_...>
GH_REPO=ahmdelbaz28-ux/BAZspark
GH_DEFAULT_BRANCH=main
# 📄 SonarCloud token (with coordinate ░░░░ — DO NOT put the real token here)
SONAR_TOKEN=<SONAR_TOKEN>

# ─── 11. SonarCloud ─────────────────────────────────────────────────────────
SONAR_ORGANIZATION=ahmdelbaz28-ux
SONAR_PROJECT_KEY=ahmdelbaz28-ux_revit
SONAR_HOST_URL=https://sonarcloud.io

# ─── 12. Cloudflare (DNS / WAF / Edge) ──────────────────────────────────────
CLOUDFLARE_API_TOKEN=<cfut_...>
CLOUDFLARE_ACCOUNT_ID=<CLOUDFLARE_ACCOUNT_ID>
CLOUDFLARE_ZONE_ID=<CLOUDFLARE_ZONE_ID>
# Multi-token rotation (stored as separate user tokens for split scopes).
CLOUDFLARE_USER_TOKEN_1=<cfut_...>
CLOUDFLARE_USER_TOKEN_2=<cfut_...>
CLOUDFLARE_USER_TOKEN_3=<cfut_...>

# ─── 13. Daytona VPS ────────────────────────────────────────────────────────
DAYTONA_API_TOKEN=<dtn_...>
DAYTONA_API_URL=https://app.daytona.io

# ─── 14. CodeSandbox VPS ────────────────────────────────────────────────────
CODESANDBOX_TOKEN=<csb_v1_...>

# ─── 15. UptimeRobot Keep-Awake Heartbeat ───────────────────────────────────
UPTIMEROBOT_USER_KEY=<u1234567-...>
UPTIMEROBOT_MONITOR_KEY=<m1234567-...>
UPTIMEROBOT_HEARTBEAT_INTERVAL=300

# ─── 16. CORS / Security Headers ────────────────────────────────────────────
# Comma-separated explicit origins. Wildcards are FORBIDDEN in production.
CORS_ORIGINS=https://ba-zspark-tau.vercel.app,https://ahmdelbaz28-bazspark.hf.space
CORS_ALLOWED_ORIGINS=https://ba-zspark-tau.vercel.app,https://ahmdelbaz28-bazspark.hf.space
# Cloudflare / Akamai integration middleware enable flags.
CF_ENABLED=false
AKAMAI_ENABLED=false
# CSRF Double Submit Cookie (disabled for pure API/agent clients).
FIREAI_CSRF_DISABLED=0

# ─── 17. Self-Healing Audit ─────────────────────────────────────────────────
# HMAC key signing the audit event chain (fireai/core/audit_store.py).
# P0-1: fail-closed in production — backend refuses to start without it.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=<AUDIT_HMAC_KEY_MIN_32_CHARS>
# HMAC key signing the QOMN computation audit chain (fireai/core/qomn_kernel.py).
# P0-1: production refuses a plain SHA-256 fallback when this is unset.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
FIREAI_QOMN_HMAC_KEY=<FIREAI_QOMN_HMAC_KEY_MIN_32_CHARS>
QOMN_AUDIT_SECRET_KEY=<QOMN_AUDIT_SECRET_KEY>
QOMN_AUDIT_LOG_PATH=/app/data/qomn_fire_healing_audit.jsonl

# ─── 18. Frontend Static Mount (HF Space mode) ───────────────────────────────
BAZSPARK_FRONTEND_DIST=/app/frontend_dist

# ─── 19. Webhook / Admin / Proxy Secrets (required — HARD) ───────────────────
# HMAC secret verifying FDS worker callbacks (POST /api/v2/fds/webhook).
FDS_WEBHOOK_SECRET=<FDS_WEBHOOK_SECRET>
# HMAC secret verifying Meeza PSP payment callbacks (POST /api/v1/billing/webhooks/meeza).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
MEEZA_WEBHOOK_HMAC_SECRET=<MEEZA_WEBHOOK_HMAC_SECRET>
# Master admin bootstrap token (rotated via POST /settings/admin-token/rotate).
BAZSPARK_MASTER_ADMIN_TOKEN=<BAZSPARK_MASTER_ADMIN_TOKEN>
# AES-256-GCM key encrypting stored 3rd-party API keys (32 bytes).
# Generate: python3 -c "import os; print(os.urandom(32).hex())"
FIREAI_VISION_KEY_ENCRYPTION_KEY=<FIREAI_VISION_KEY_ENCRYPTION_KEY_32_BYTES>
# Comma-separated CIDR list of reverse proxies allowed to set X-Forwarded-For.
TRUSTED_PROXIES=<TRUSTED_PROXIES_CIDR_LIST>

# ─── 20. Optional Kubernetes (when deploying to bare metal / cloud K8s) ─────
# KUBE_CONFIG_PRODUCTION=<base64-encoded kubeconfig>

{
  "version": 1,
  "description": "Unified CAD control command registry. Canonical name -> C# add-in action + params schema + channel. Single source of truth shared by backend allow-list validation (D4), scripts/local_agent.py routing/normalization (A2), and contract tests.",
  "services": {
    "revit": {
      "pipe_name": "\\\\.\\pipe\\bazspark_revit",
      "commands": {
        "get_info": {
          "addin_action": "get_info",
          "channel": ["pipe", "local"],
          "risk": "query",
          "params": { "required": [], "optional": {} }
        },
        "get_elements": {
          "addin_action": "list_elements",
          "aliases": ["list_elements"],
          "channel": ["pipe", "local"],
          "risk": "query",
          "params": { "required": [], "optional": { "category": "" } }
        },
        "create_wall": {
          "addin_action": "create_wall",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["start_point", "end_point"],
            "optional": { "height": 3000.0, "level": "Level 1", "wall_type": "Basic Wall" }
          }
        },
        "create_floor": {
          "addin_action": "create_floor",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["boundary_points"],
            "optional": { "level": "Level 1", "floor_type": "Floor" }
          }
        },
        "place_family_instance": {
          "addin_action": "place_family_instance",
          "aliases": ["create_family"],
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["family_name", "location_point"],
            "optional": { "category": "", "level": "", "parameters": {} }
          }
        },
        "place_family_instance_hosted": {
          "addin_action": "place_family_instance_hosted",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["family_name", "location_point"],
            "optional": { "host_id": null, "level": "", "parameters": {} }
          }
        },
        "create_door": {
          "addin_action": "place_family_instance_hosted",
          "aliases": [],
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["host_wall_id", "location_point"],
            "optional": { "family_type": "M_Single-Flush", "level": "Level 1" }
          }
        },
        "create_window": {
          "addin_action": "place_family_instance_hosted",
          "aliases": [],
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["host_wall_id", "location_point"],
            "optional": { "family_type": "M_Single-Flush", "level": "Level 1" }
          }
        },
        "create_column": {
          "addin_action": "create_column",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["location_point"],
            "optional": { "height": 3000.0, "level": "Level 1", "column_type": "" }
          }
        },
        "create_beam": {
          "addin_action": "create_beam",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["start_point", "end_point"],
            "optional": { "level": "Level 1", "beam_type": "" }
          }
        },
        "place_fire_devices": {
          "addin_action": "place_fire_devices",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": [], "optional": { "devices": [] } }
        },
        "create_conduit_run": {
          "addin_action": "create_conduit_run",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": [],
            "optional": { "start_point": [0, 0, 0], "end_point": [1000, 0, 0], "diameter": 20.0 }
          }
        },
        "delete_element": {
          "addin_action": "delete_element",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": { "required": ["element_id"], "optional": {} }
        },
        "get_parameter": {
          "addin_action": "get_parameter",
          "channel": ["pipe", "local"],
          "risk": "query",
          "params": { "required": ["element_id", "name"], "optional": {} }
        },
        "set_parameter": {
          "addin_action": "set_parameter",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": { "required": ["element_id", "name", "value"], "optional": {} }
        },
        "update_parameters": {
          "addin_action": "set_parameter",
          "expands_to": "set_parameter",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": { "required": ["element_id", "parameters"], "optional": {} }
        },
        "get_views": {
          "addin_action": "list_views",
          "aliases": ["list_views"],
          "channel": ["pipe", "local"],
          "risk": "query",
          "params": { "required": [], "optional": {} }
        },
        "get_levels": {
          "addin_action": "list_levels",
          "channel": ["pipe", "local"],
          "risk": "query",
          "params": { "required": [], "optional": {} }
        },
        "get_grids": {
          "addin_action": "list_grids",
          "channel": ["pipe", "local"],
          "risk": "query",
          "params": { "required": [], "optional": {} }
        },
        "get_worksets": {
          "addin_action": "get_worksets",
          "channel": ["local"],
          "risk": "query",
          "params": { "required": [], "optional": {} }
        },
        "execute_ai_command": {
          "addin_action": "execute_ai_command",
          "channel": ["local"],
          "risk": "mutation",
          "params": { "required": ["command"], "optional": { "context": {} } }
        },
        "save": {
          "addin_action": "save",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": { "required": [], "optional": {} }
        },
        "open_document": {
          "addin_action": "open_document",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["filepath"], "optional": {} }
        },
        "close_document": {
          "addin_action": "close_document",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": [], "optional": { "save_changes": true } }
        },
        "create_sheet": {
          "addin_action": "create_sheet",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["titleblock_name"],
            "optional": { "sheet_number": "", "sheet_name": "", "view_id": null }
          }
        },
        "create_level": {
          "addin_action": "create_level",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["name", "elevation_mm"], "optional": {} }
        },
        "create_grid": {
          "addin_action": "create_grid",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["start_point", "end_point"],
            "optional": { "name": "" }
          }
        },
        "export_dwg": {
          "addin_action": "export_dwg",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["filepath"], "optional": { "view_id": null } }
        },
        "export_pdf": {
          "addin_action": "export_pdf",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["filepath"], "optional": { "view_id": null } }
        },
        "export_ifc": {
          "addin_action": "export_ifc",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["filepath"], "optional": {} }
        },
        "select_elements": {
          "addin_action": "select_elements",
          "channel": ["pipe"],
          "risk": "ui",
          "params": { "required": ["element_ids"], "optional": {} }
        },
        "get_selection": {
          "addin_action": "get_selection",
          "channel": ["pipe"],
          "risk": "query",
          "params": { "required": [], "optional": {} }
        },
        "zoom_to_fit": {
          "addin_action": "zoom_to_fit",
          "channel": ["pipe"],
          "risk": "ui",
          "params": { "required": [], "optional": {} }
        },
        "post_command": {
          "addin_action": "post_command",
          "channel": ["pipe"],
          "risk": "native_passthrough",
          "params": {
            "required": ["postable_command"],
            "optional": {}
          }
        },
        "undo_group": {
          "addin_action": "undo_group",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["name", "actions"],
            "optional": {}
          }
        },
        "speckle_pull": {
          "addin_action": "speckle_pull",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["stream_id", "token"], "optional": { "server_url": "https://speckle.xyz" } }
        },
        "capture_screen": {
          "addin_action": "capture_screen",
          "channel": ["pipe"],
          "risk": "query",
          "params": { "required": [], "optional": {} }
        }
      }
    },
    "autocad": {
      "pipe_name": "\\\\.\\pipe\\bazspark_autocad",
      "commands": {
        "get_info": {
          "addin_action": "get_info",
          "channel": ["pipe", "local"],
          "risk": "query",
          "params": { "required": [], "optional": {} }
        },
        "draw_line": {
          "addin_action": "draw_line",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["start_point", "end_point"],
            "optional": { "layer": "0", "color": 0 }
          }
        },
        "draw_polyline": {
          "addin_action": "draw_polyline",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["vertices"],
            "optional": { "layer": "0", "color": 0, "closed": false }
          }
        },
        "draw_circle": {
          "addin_action": "draw_circle",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["center", "radius"],
            "optional": { "layer": "0", "color": 0 }
          }
        },
        "draw_text": {
          "addin_action": "draw_text",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["text", "insertion_point"],
            "optional": { "height": 0.2, "layer": "0", "color": 0 }
          }
        },
        "draw_mtext": {
          "addin_action": "draw_mtext",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["text", "insertion_point"],
            "optional": { "width": 50.0, "height": 0.2, "layer": "0", "color": 0 }
          }
        },
        "draw_arc": {
          "addin_action": "draw_arc",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["center", "radius", "start_angle_deg", "end_angle_deg"],
            "optional": { "layer": "0", "color": 0 }
          }
        },
        "draw_ellipse": {
          "addin_action": "draw_ellipse",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["center", "major_axis_vector", "minor_ratio"],
            "optional": { "layer": "0", "color": 0 }
          }
        },
        "draw_hatch": {
          "addin_action": "draw_hatch",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["boundary_handle"],
            "optional": { "pattern": "SOLID", "scale": 1.0, "layer": "0", "color": 0 }
          }
        },
        "draw_dimension": {
          "addin_action": "draw_dimension",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["start_point", "end_point", "dim_line_point"],
            "optional": { "layer": "0", "color": 0 }
          }
        },
        "draw_leader": {
          "addin_action": "draw_leader",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["start_point", "end_point", "annotation"],
            "optional": { "layer": "0", "color": 0 }
          }
        },
        "insert_block": {
          "addin_action": "insert_block",
          "aliases": ["insert_block_instance"],
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": {
            "required": ["block_name", "insertion_point"],
            "optional": { "rotation_deg": 0.0, "scale": 1.0, "attributes": {}, "layer": "", "color": 0 }
          }
        },
        "get_block_attributes": {
          "addin_action": "get_block_attributes",
          "channel": ["pipe"],
          "risk": "query",
          "params": { "required": ["handle"], "optional": {} }
        },
        "query_elements": {
          "addin_action": "query_elements",
          "channel": ["pipe"],
          "risk": "query",
          "params": { "required": [], "optional": { "layer": "", "limit": 500 } }
        },
        "get_entity_info": {
          "addin_action": "get_entity_info",
          "channel": ["pipe"],
          "risk": "query",
          "params": { "required": ["handle"], "optional": {} }
        },
        "get_entity_at_point": {
          "addin_action": "get_entity_at_point",
          "channel": ["pipe"],
          "risk": "query",
          "params": { "required": ["point"], "optional": {} }
        },
        "delete_entity": {
          "addin_action": "delete_entity",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": { "required": ["handle"], "optional": {} }
        },
        "modify_entity": {
          "addin_action": "modify_entity",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": { "required": ["handle", "properties"], "optional": {} }
        },
        "send_command": {
          "addin_action": "send_command",
          "channel": ["pipe"],
          "risk": "native_passthrough",
          "params": { "required": ["command_string"], "optional": {} }
        },
        "open_drawing": {
          "addin_action": "open_drawing",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["filepath"], "optional": {} }
        },
        "zoom_extents": {
          "addin_action": "zoom_extents",
          "channel": ["pipe"],
          "risk": "ui",
          "params": { "required": [], "optional": {} }
        },
        "create_layer": {
          "addin_action": "create_layer",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["name"],
            "optional": { "color_index": 7, "linetype": "Continuous" }
          }
        },
        "set_active_layer": {
          "addin_action": "set_active_layer",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["name"], "optional": {} }
        },
        "plot_pdf": {
          "addin_action": "plot_pdf",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": {
            "required": ["filepath"],
            "optional": { "layout": "Model", "media_name": "ISO_full_bleed_A3_(420.00_x_297.00_MM)" }
          }
        },
        "save_as": {
          "addin_action": "save_as",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["filepath"], "optional": {} }
        },
        "save": {
          "addin_action": "save",
          "channel": ["pipe", "local"],
          "risk": "mutation",
          "params": { "required": ["filepath"], "optional": {} }
        },
        "speckle_push": {
          "addin_action": "speckle_push",
          "channel": ["pipe"],
          "risk": "mutation",
          "params": { "required": ["stream_id", "token"], "optional": { "server_url": "https://speckle.xyz" } }
        },
        "capture_screen": {
          "addin_action": "capture_screen",
          "channel": ["pipe"],
          "risk": "query",
          "params": { "required": [], "optional": {} }
        }
      }
    }
  }
}

        "path": [],
        "query": [],
        "header": []
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "format": "password",
            "description": "API key for authentication (dpk_...)"
          },
          "username": {
            "type": "string",
            "description": "Username (optional, for compatibility)"
          }
        },
        "required": [
          "api_key"
        ]
      },
      "response_schemas": {
        "success": {
          "status_code": 200,
          "schema": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean"
              },
              "data": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "engineer",
                      "viewer"
                    ]
                  },
                  "session_expires": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          },
          "description": "Authentication successful, session cookie set"
        },
        "error": [
          {
            "status_code": 401,
            "description": "Invalid API key"
          },
          {
            "status_code": 429,
            "description": "Too many login attempts"

          {
            "status_code": 500,
            "description": "Internal server error"
          }
        ]
      },
      "error_responses": {
        "401": "Invalid API key",
        "429": "Too many login attempts",
        "500": "Internal server error"
      },
      "auth_required": false,
      "auth_details": "No authentication required — this is the login endpoint",
      "rate_limit": "5/minute",
      "notes": [
        "Sets HttpOnly, Secure, SameSite=Lax cookie named 'session_id'",
        "Session secret must be >= 43 chars (256 bits of entropy)"
      ],
      "examples": {

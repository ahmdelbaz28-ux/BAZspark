{
        "name": "bazspark",
        "version": "1.56.0",
        "type": "module",
        "private": true,
        "description": "BAZSpark — Safety-Critical Fire Alarm Engineering Platform",
        "author": {
                "name": "Eng. Ahmed Elbaz",
                "email": "engineering@bazspark.com"
        },
        "homepage": "https://bazspark.com",
        "license": "MIT",
        "scripts": {
                "dev": "vite dev",
                "build": "vite build",
                "build:electron": "npm run build && npm run compile:electron && npm run copy:backend && electron-builder",
                "compile:electron": "tsc -p tsconfig.electron.json",
                "copy:backend": "node scripts/copy-backend.cjs",
                "preview": "vite preview",
                "typecheck": "tsc -p tsconfig.json --noEmit",
                "test": "vitest run --no-file-parallelism",
                "test:watch": "vitest",
                "test:visual": "playwright test --reporter=list",
                "test:visual:ui": "playwright test --ui",
                "test:visual:update": "playwright test --update-snapshots",
                "test:a11y": "playwright test --grep @a11y --reporter=list",
                "audit": "npm audit --audit-level=high",
                "audit:fix": "npm audit fix",
                "outdated": "npm outdated",
                "lint": "eslint src/",
                "lint:fix": "eslint src --ext .ts,.tsx --fix",
                "lint:boundaries": "depcruise --ts-pre-compilation-deps src/packages",
                "perf:check": "node scripts/validate-perf-budget.cjs",
                "docs:check": "node ../scripts/validate-readme-drift.cjs",
                "ci": "npm ci && npm run typecheck && npm run audit && npm run lint:boundaries && npm run test && npm run build && npm run perf:check && npm run docs:check"
        },
        "dependencies": {
                "@gsap/react": "^2.1.1",
                "@hookform/resolvers": "^5.8.0",
                "@radix-ui/react-accordion": "^1.2.12",
                "@radix-ui/react-alert-dialog": "^1.1.15",
                "@radix-ui/react-aspect-ratio": "^1.1.8",
                "@radix-ui/react-avatar": "^1.1.11",
                "@radix-ui/react-checkbox": "^1.3.3",
                "@radix-ui/react-collapsible": "^1.1.12",
                "@radix-ui/react-context-menu": "^2.2.16",
                "@radix-ui/react-dialog": "^1.1.15",
                "@radix-ui/react-dropdown-menu": "^2.1.16",
                "@radix-ui/react-hover-card": "^1.1.15",
                "@radix-ui/react-label": "^2.1.8",
                "@radix-ui/react-menubar": "^1.1.16",
                "@radix-ui/react-navigation-menu": "^1.2.14",
                "@radix-ui/react-popover": "^1.1.15",
                "@radix-ui/react-progress": "^1.1.8",
                "@radix-ui/react-radio-group": "^1.3.8",
                "@radix-ui/react-scroll-area": "^1.2.10",
                "@radix-ui/react-select": "^2.2.6",
                "@radix-ui/react-separator": "^1.1.8",
                "@radix-ui/react-slider": "^1.3.6",
                "@radix-ui/react-slot": "^1.2.4",
                "@radix-ui/react-switch": "^1.2.6",
                "@radix-ui/react-tabs": "^1.1.13",
                "@radix-ui/react-toast": "^1.2.15",
                "@radix-ui/react-toggle": "^1.1.10",
                "@radix-ui/react-toggle-group": "^1.1.11",
                "@radix-ui/react-tooltip": "^1.2.8",
                "@react-three/drei": "^10.7.8",
                "@react-three/fiber": "^9.7.0",
                "@sentry/react": "8.55.2",
                "@tailwindcss/postcss": "4.3.3",
                "@tanstack/react-query": "5.101.4",
                "@types/d3": "^7.4.3",
                "@vercel/analytics": "^2.0.1",
                "@vercel/speed-insights": "^2.0.0",
                "autoprefixer": "10.5.4",
                "class-variance-authority": "^0.7.0",
                "clsx": "^2.1.0",
                "cmdk": "^1.1.1",
                "d3": "^7.9.0",
                "date-fns": "^4.4.0",
                "dxf-parser": "1.1.2",
                "embla-carousel-react": "^8.6.0",
                "file-saver": "2.0.5",
                "framer-motion": "^13.1.0",
                "gsap": "^3.12.5",
                "i18next": "^26.4.0",
                "i18next-browser-languagedetector": "^8.2.1",
                "input-otp": "^1.5.0",
                "lucide-react": "^1.31.0",
                "motion-dom": "^13.1.1",
                "next-themes": "^0.4.6",
                "postcss": "^8.5.26",
                "react": "^19.2.8",
                "react-day-picker": "^10.0.1",
                "react-dom": "^19.2.8",
                "react-hook-form": "^7.85.0",
                "react-i18next": "^17.0.12",
                "react-resizable-panels": "^4.12.2",
                "react-router": "^8.3.0",
                "recharts": "^3.10.1",
                "sonner": "^2.0.8",
                "tailwind-merge": "^3.6.0",
                "three": "^0.185.1",
                "vaul": "^1.1.2",
                "zod": "^4.4.3"
        },
        "devDependencies": {
                "@axe-core/playwright": "^4.13.0",
                "@eslint/js": "^10.0.1",
                "@playwright/test": "^1.62.1",
                "@tailwindcss/vite": "^4.3.2",
                "@testing-library/dom": "^10.4.1",
                "@testing-library/jest-dom": "^7.0.1",
                "@testing-library/react": "^16.3.2",
                "@testing-library/user-event": "^14.6.5",
                "@types/file-saver": "2.0.7",
                "@types/node": "^26.2.0",
                "@types/react": "^19.2.18",
                "@types/react-dom": "^19.2.4",
                "@types/terser": "^3.12.0",
                "@types/three": "^0.185.4",
                "@vitejs/plugin-react": "^6.0.6",
                "@vitest/coverage-v8": "^4.1.11",
                "chokidar": "^5.0.0",
                "dependency-cruiser": "^18.2.0",
                "electron": "^43.3.0",
                "electron-builder": "^26.15.3",
                "eslint": "^10.8.1",
                "eslint-plugin-react-hooks": "^7.1.1",
                "fast-glob": "^3.3.3",
                "globals": "^17.11.0",
                "jsdom": "^30.0.1",
                "tailwindcss": "^4.0.0",
                "terser": "^5.49.2",
                "tw-animate-css": "^1.4.0",
                "typescript": "^5.9.3",
                "typescript-eslint": "^8.67.0",
                "vite": "^8.2.2",
                "vitest": "^4.1.11"
        },
        "overrides": {
                "rimraf": "^6.0.0",
                "glob": "^11.0.0"
        },
        "build": {
                "appId": "org.fireai.digitaltwin",
                "productName": "FireAI Digital Twin",
                "directories": {
                        "output": "release"
                },
                "files": [
                        {
                                "from": ".",
                                "filter": [
                                        "dist/**/*"
                                ]
                        },
                        {
                                "from": ".",
                                "filter": [
                                        "electron/compiled/**/*"
                                ]
                        },
                        {
                                "from": ".",
                                "filter": [
                                        "electron/backend/**/*"
                                ]
                        },
                        {
                                "from": ".",
                                "filter": [
                                        "electron/parsers/**/*"
                                ]
                        },
                        {
                                "from": ".",
                                "filter": [
                                        "electron/core/**/*"
                                ]
                        },
                        {
                                "from": ".",
                                "filter": [
                                        "electron/fireai/**/*"
                                ]
                        },
                        {
                                "from": ".",
                                "filter": [
                                        "electron/requirements.txt"
                                ]
                        },
                        {
                                "from": ".",
                                "filter": [
                                        "package.json"
                                ]
                        }
                ],
                "extraResources": [],
                "asarUnpack": [
                        "electron/backend/**",
                        "electron/parsers/**",
                        "electron/core/**",
                        "electron/fireai/**"
                ],
                "win": {
                        "target": [
                                "nsis",
                                "portable"
                        ],
                        "artifactName": "FireAI-DigitalTwin-${version}-${arch}.${ext}"
                },
                "linux": {
                        "target": [
                                "AppImage"
                        ],
                        "artifactName": "FireAI-DigitalTwin-${version}-${arch}.${ext}"
                },
                "mac": {
                        "target": [
                                "dmg",
                                "zip"
                        ],
                        "artifactName": "FireAI-DigitalTwin-${version}-${arch}.${ext}"
                },
                "nsis": {
                        "oneClick": false,
                        "perMachine": false,
                        "allowToChangeInstallationDirectory": true,
                        "installerIcon": "build/icon.ico",
                        "uninstallerIcon": "build/icon.ico",
                        "installerSidebar": "build/installerSidebar.bmp"
                },
                "extraMetadata": {
                        "main": "electron/compiled/main.js"
                }
        }
}
